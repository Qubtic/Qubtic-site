# Shared Qubtic Auth configuration, used by Frame Drop and WhatsApp Commerce.
# Server only: never add the service role key or SMTP password to VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-server-service-role-key
NEXT_PUBLIC_SITE_URL=https://www.qubtic.tech
# Verification emails use Qubtic's existing branded SMTP email service,
# not Supabase Auth signup/templates. Configure SMTP in the server environment.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_FROM_EMAIL=hello@qubtic.tech
