# Qubtic server credentials — configure in Vercel, never in the dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SESSION_SECRET=
# Required only for encrypted Polar credentials managed in Plugins & payments.
PLUGIN_CONFIG_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=https://www.qubtic.tech
# Scheduled notification / billing workers.
CRON_SECRET=

# Shared transactional SMTP (verification, password resets, team and admin mail).
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=hello@qubtic.tech
SMTP_FROM_NAME=Qubtic Studio
# Default team inbox; the dashboard can override the notification recipient.
TEAM_NOTIFICATION_EMAIL=
CONTACT_RECEIVER_EMAIL=

# Existing Cloudinary media manager. Only the cloud name is public.
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.qubtic.tech/api/framer-auth/google/callback
