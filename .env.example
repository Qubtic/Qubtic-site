# SMTP Mail Server Configuration Template
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=
SMTP_FROM_EMAIL=hello@qubtic.tech
SMTP_FROM_NAME="Qubtic Studio"
CONTACT_RECEIVER_EMAIL=hello@qubtic.tech

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=




# Central Qubtic website/auth/billing server configuration.
# Copy this file to .env.local for local development. In hosting, use server Environment Variables.
# Never overwrite an existing .env/.env.local containing real credentials.
NEXT_PUBLIC_SITE_URL=https://www.qubtic.tech
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate two DIFFERENT random secrets, minimum 32 characters each (see guide).
ADMIN_SESSION_SECRET=
BILLING_CRON_SECRET=

# Polar dashboard credentials: all plugins share ONE organization/backend per environment.
# Start in sandbox. Replace ALL IDs, token, and webhook secret together for production.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=

# Product IDs are identifiers, not checkout links, Price IDs, or license keys.
# Fill all four keys for a plugin to enable its monthly/yearly/lifetime plans.
# Run npm run billing:configure to validate and sync these IDs to billing_catalog.
# WhatsApp Commerce: one shared Pro benefit across these three products.
POLAR_WHATSAPP_COMMERCE_MONTHLY_PRODUCT_ID=
POLAR_WHATSAPP_COMMERCE_YEARLY_PRODUCT_ID=
POLAR_WHATSAPP_COMMERCE_LIFETIME_PRODUCT_ID=
POLAR_WHATSAPP_COMMERCE_PRO_BENEFIT_ID=
# FrameDrop
POLAR_FRAME_DROP_MONTHLY_PRODUCT_ID=
POLAR_FRAME_DROP_YEARLY_PRODUCT_ID=
POLAR_FRAME_DROP_LIFETIME_PRODUCT_ID=
POLAR_FRAME_DROP_PRO_BENEFIT_ID=
# Qube Auth
POLAR_QUBE_AUTH_MONTHLY_PRODUCT_ID=
POLAR_QUBE_AUTH_YEARLY_PRODUCT_ID=
POLAR_QUBE_AUTH_LIFETIME_PRODUCT_ID=
POLAR_QUBE_AUTH_PRO_BENEFIT_ID=
# Optional future plugins: JSON array of {plugin_slug,cadence,product_id,benefit_id}.
# Supply all three cadences per extra plugin. Keep this JSON on ONE line.
POLAR_EXTRA_CATALOG_JSON=[]

# Optional server-side Polar discounts; only configured eligible products receive these.
POLAR_WHATSAPP_COMMERCE_YEARLY_DISCOUNT_ID=
POLAR_WHATSAPP_COMMERCE_LIFETIME_DISCOUNT_ID=
