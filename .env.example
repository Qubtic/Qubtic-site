# SMTP Mail Server Configuration Template
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=
SMTP_FROM_EMAIL=hello@qubtic.tech
SMTP_FROM_NAME="Qubtic Studio"
CONTACT_RECEIVER_EMAIL=hello@qubtic.tech

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=




# Google OAuth 2.0 Credentials (Framer Auth Portal & Plugin Google Sign-In)
# Production Authorized Redirect URI: https://qubtic.tech/api/framer-auth/google/callback
# Development Authorized Redirect URI: http://localhost:3000/api/framer-auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Central Qubtic website/auth/billing server configuration.
# Copy this file to .env.local for local development. In hosting, use server Environment Variables.
# Never overwrite an existing .env/.env.local containing real credentials.
NEXT_PUBLIC_SITE_URL=https://www.qubtic.tech
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate two DIFFERENT random secrets, minimum 32 characters each (see guide).
ADMIN_SESSION_SECRET=
BILLING_CRON_SECRET=
# Optional Vercel Cron bearer secret; configure in Vercel when scheduling jobs.
CRON_SECRET=

# Both environments coexist in one Vercel deployment. No global billing mode.
# Copy matching keys from .env.production.example and .env.sandbox.example.
# Server-only production values. Merge into .env locally or Vercel server variables.
# This file is a template; .env.sandbox is not automatically loaded by Next.js.
POLAR_PRODUCTION_ACCESS_TOKEN=
POLAR_PRODUCTION_ORGANIZATION_ID=
POLAR_PRODUCTION_WEBHOOK_SECRET=
POLAR_PRODUCTION_WHATSAPP_COMMERCE_MONTHLY_PRODUCT_ID=
POLAR_PRODUCTION_WHATSAPP_COMMERCE_YEARLY_PRODUCT_ID=
POLAR_PRODUCTION_WHATSAPP_COMMERCE_LIFETIME_PRODUCT_ID=
POLAR_PRODUCTION_TELEGRAM_COMMERCE_MONTHLY_PRODUCT_ID=
POLAR_PRODUCTION_TELEGRAM_COMMERCE_YEARLY_PRODUCT_ID=
POLAR_PRODUCTION_TELEGRAM_COMMERCE_LIFETIME_PRODUCT_ID=
POLAR_PRODUCTION_FRAME_DROP_MONTHLY_PRODUCT_ID=
POLAR_PRODUCTION_FRAME_DROP_YEARLY_PRODUCT_ID=
POLAR_PRODUCTION_FRAME_DROP_LIFETIME_PRODUCT_ID=
POLAR_PRODUCTION_QUBE_AUTH_MONTHLY_PRODUCT_ID=
POLAR_PRODUCTION_QUBE_AUTH_YEARLY_PRODUCT_ID=
POLAR_PRODUCTION_QUBE_AUTH_LIFETIME_PRODUCT_ID=
POLAR_PRODUCTION_WHATSAPP_COMMERCE_PRO_BENEFIT_ID=
POLAR_PRODUCTION_TELEGRAM_COMMERCE_PRO_BENEFIT_ID=
POLAR_PRODUCTION_FRAME_DROP_PRO_BENEFIT_ID=
POLAR_PRODUCTION_QUBE_AUTH_PRO_BENEFIT_ID=
POLAR_PRODUCTION_EXTRA_CATALOG_JSON=[]

# Server-only sandbox values. Merge into .env locally or Vercel server variables.
# This file is a template; .env.sandbox is not automatically loaded by Next.js.
POLAR_SANDBOX_ACCESS_TOKEN=
POLAR_SANDBOX_ORGANIZATION_ID=
POLAR_SANDBOX_WEBHOOK_SECRET=
POLAR_SANDBOX_WHATSAPP_COMMERCE_MONTHLY_PRODUCT_ID=
POLAR_SANDBOX_WHATSAPP_COMMERCE_YEARLY_PRODUCT_ID=
POLAR_SANDBOX_WHATSAPP_COMMERCE_LIFETIME_PRODUCT_ID=
POLAR_SANDBOX_TELEGRAM_COMMERCE_MONTHLY_PRODUCT_ID=
POLAR_SANDBOX_TELEGRAM_COMMERCE_YEARLY_PRODUCT_ID=
POLAR_SANDBOX_TELEGRAM_COMMERCE_LIFETIME_PRODUCT_ID=
POLAR_SANDBOX_FRAME_DROP_MONTHLY_PRODUCT_ID=
POLAR_SANDBOX_FRAME_DROP_YEARLY_PRODUCT_ID=
POLAR_SANDBOX_FRAME_DROP_LIFETIME_PRODUCT_ID=
POLAR_SANDBOX_QUBE_AUTH_MONTHLY_PRODUCT_ID=
POLAR_SANDBOX_QUBE_AUTH_YEARLY_PRODUCT_ID=
POLAR_SANDBOX_QUBE_AUTH_LIFETIME_PRODUCT_ID=
POLAR_SANDBOX_WHATSAPP_COMMERCE_PRO_BENEFIT_ID=
POLAR_SANDBOX_TELEGRAM_COMMERCE_PRO_BENEFIT_ID=
POLAR_SANDBOX_FRAME_DROP_PRO_BENEFIT_ID=
POLAR_SANDBOX_QUBE_AUTH_PRO_BENEFIT_ID=
